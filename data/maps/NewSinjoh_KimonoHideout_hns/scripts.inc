NewSinjoh_KimonoHideout_Text_ShizukoFinal:
	.string "SHIZUKO: Pocos ENTRENADORES en toda\n"
	.string "la larga historia de SINJOH han\l"
	.string "logrado lo que acabas de hacer.\p"
	.string "Muy impresionante, {PLAYER}.$"

@ =================================================================================================

NewSinjoh_KimonoHideout_EventScript_OldMan::
	msgbox NewSinjoh_KimonoHideout_Text_OldMan, MSGBOX_NPC
	end

NewSinjoh_KimonoHideout_Text_OldMan:
	.string "Las CHICAS KIMONO velan por nuestra\n"
	.string "aldea desde su fundación.\p"
	.string "Han sacrificado mucho.\p"
	.string "Bendecidas por los mismísimos dioses,\n"
	.string "¡tienen poderes que superan a los de\l"
	.string "cualquier ENTRENADOR normal!\p"
	.string "O sea, que estés preparado si alguna\n"
	.string "vez luchas contra ellas, jovencito.$"

NewSinjoh_KimonoHideout_Text_OldManAfter:
	.string "Has vencido a las campeonas de\n"
	.string "nuestra aldea.\p"
	.string "¿En qué te convierte eso, jovencito?$"
