NewSinjoh_KimonoHideout_Text_ShizukoBeforeBattle:
	.string "SHIZUKO: Estamos entrenadas tanto en\n"
	.string "el combate como en la danza.\p"
	.string "Para conseguir las TABLAS hacen falta\n"
	.string "fuerza y determinación.$"

NewSinjoh_KimonoHideout_Text_ShizukoAfter:
	.string "SHIZUKO: El vínculo que tienes con\n"
	.string "tus POKéMON es muy fuerte.\p"
	.string "Te has ganado esta TABLA.$"

