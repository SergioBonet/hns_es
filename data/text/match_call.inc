	.string "¡Y que hay tres ejemplares!\p"
	.string "¡Lo que daría por ver uno!$"

MatchCall_Text_Brendan14::
	.string "BRUNO: ¡{PLAYER}!\n"
	.string "¡Me han llegado rumores!\p"
