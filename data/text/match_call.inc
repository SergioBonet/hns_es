	.string "otra vez, ven a verme a mi oficina.\p"
	.string "¡Aquí te espero!$"

MatchCall_Text_MrStone4::
	.string "SR. PEÑAS: ¡Oh! ¡{PLAYER}{KUN}!\p"
	.string "¿Sabías que DEVON estaba excavando\n"
