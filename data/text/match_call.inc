	.string "Mmm… ¿Cómo?…\p"
	.string "CAVERN… ¿Cómo? ¿…BISAL?\p"
	.string "Se entrecorta…\n"
	.string "Eh… no te oigo…\p"
	.string "BZZZZ…$"

